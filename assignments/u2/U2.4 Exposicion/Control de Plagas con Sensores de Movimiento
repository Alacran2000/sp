### 1. Código del Sensor Principal (ESP32)

```cpp
#include <WiFi.h>
#include <PubSubClient.h>
#include <HC-SR04.h>

// Configuración WiFi
const char* ssid = "Farm_Network";
const char* password = "secure_password";

// Configuración MQTT
const char* mqtt_server = "192.168.1.100";
const char* mqtt_topic_motion = "pest/motion";
const char* mqtt_topic_alert = "pest/alert";

// Pines
const int pirPin = 4;
const int ultrasonicTrig = 5;
const int ultrasonicEcho = 6;
const int strobeLed = 12;
const int speakerPin = 13;

// Variables
bool motionDetected = false;
long lastDetectionTime = 0;
int detectionCount = 0;

HCSR04 hcsr04(ultrasonicTrig, ultrasonicEcho);

void setup() {
  Serial.begin(115200);
  pinMode(pirPin, INPUT);
  pinMode(strobeLed, OUTPUT);
  pinMode(speakerPin, OUTPUT);
  
  setupWiFi();
  setupMQTT();
}

void loop() {
  checkMotion();
  checkClientConnection();
  delay(500);
}

void checkMotion() {
  bool currentMotion = digitalRead(pirPin);
  float distance = hcsr04.distance();
  
  if (currentMotion && distance < 300) { // Movimiento dentro de 3m
    motionDetected = true;
    lastDetectionTime = millis();
    detectionCount++;
    
    // Publicar detección
    publishMotionData(distance);
    
    // Activar disuasores
    activateDeterrents();
    
    // Publicar alerta si es múltiple
    if (detectionCount > 3) {
      publishAlert(distance);
    }
  } else {
    motionDetected = false;
    if (millis() - lastDetectionTime > 30000) { // Reset después de 30s
      detectionCount = 0;
    }
  }
}

void publishMotionData(float distance) {
  String payload = "{";
  payload += "\"sensor_id\":\"pest_sensor_01\",";
  payload += "\"location\":\"cultivo_maiz_norte\",";
  payload += "\"distance_cm\":" + String(distance) + ",";
  payload += "\"detection_count\":" + String(detectionCount) + ",";
  payload += "\"timestamp\":" + String(millis());
  payload += "}";
  
  client.publish(mqtt_topic_motion, payload.c_str());
}

void activateDeterrents() {
  // LED Strobe
  digitalWrite(strobeLed, HIGH);
  delay(200);
  digitalWrite(strobeLed, LOW);
  
  // Sonido ultrasónico (opcional)
  tone(speakerPin, 25000, 1000); // 25kHz por 1 segundo
  
  Serial.println("Disuasores activados para plaga detectada");
}
```

### 2. Procesador MQTT a InfluxDB

```python
import paho.mqtt.client as mqtt
from influxdb_client import InfluxDBClient, Point
from influxdb_client.client.write_api import SYNCHRONOUS
import json
from datetime import datetime
import requests

# Configuración
INFLUXDB_URL = "http://localhost:8086"
INFLUXDB_TOKEN = "your-token"
INFLUXDB_ORG = "pest_control"
INFLUXDB_BUCKET = "pest_monitoring"

TELEGRAM_BOT_TOKEN = "your_bot_token"
TELEGRAM_CHAT_ID = "farmer_chat_id"

client = InfluxDBClient(url=INFLUXDB_URL, token=INFLUXDB_TOKEN, org=INFLUXDB_ORG)
write_api = client.write_api(write_options=SYNCHRONOUS)

detection_history = {}

def on_message(client, userdata, msg):
    try:
        topic = msg.topic
        payload = json.loads(msg.payload.decode())
        
        if "pest/motion" in topic:
            process_motion_data(payload)
        elif "pest/alert" in topic:
            process_alert_data(payload)
            
    except Exception as e:
        print(f"Error procesando mensaje: {e}")

def process_motion_data(data):
    # Guardar en InfluxDB
    point = Point("pest_detection") \
        .tag("sensor_id", data["sensor_id"]) \
        .tag("location", data["location"]) \
        .field("distance", data["distance_cm"]) \
        .field("detection_count", data["detection_count"])
    
    write_api.write(bucket=INFLUXDB_BUCKET, org=INFLUXDB_ORG, record=point)
    
    # Análisis de patrones
    analyze_detection_patterns(data)

def analyze_detection_patterns(data):
    sensor_id = data["sensor_id"]
    current_time = datetime.now()
    
    # Inicializar historial si no existe
    if sensor_id not in detection_history:
        detection_history[sensor_id] = []
    
    # Agregar detección actual
    detection_history[sensor_id].append(current_time)
    
    # Limpiar detecciones antiguas (últimas 2 horas)
    detection_history[sensor_id] = [
        dt for dt in detection_history[sensor_id] 
        if (current_time - dt).total_seconds() < 7200
    ]
    
    # Verificar actividad sospechosa
    if len(detection_history[sensor_id]) >= 5:
        send_telegram_alert(
            f"🚨 ALTA ACTIVIDAD DE PLAGAS\n"
            f"📍 Ubicación: {data['location']}\n"
            f"🔢 Detecciones: {len(detection_history[sensor_id])} en 2h\n"
            f"📏 Distancia promedio: {data['distance_cm']}cm\n"
            f"⏰ Hora: {current_time.strftime('%H:%M')}"
        )

def send_telegram_alert(message):
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": message,
        "parse_mode": "HTML"
    }
    
    try:
        response = requests.post(url, json=payload)
        print(f"Alerta enviada: {response.status_code}")
    except Exception as e:
        print(f"Error enviando alerta: {e}")

# Configurar cliente MQTT
mqtt_client = mqtt.Client()
mqtt_client.on_message = on_message
mqtt_client.connect("localhost", 1883, 60)
mqtt_client.subscribe("pest/#")
mqtt_client.loop_forever()
```

