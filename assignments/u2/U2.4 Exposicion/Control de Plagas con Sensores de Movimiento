### 4. Sistema Avanzado de Disuasión

```python
class PestDeterrentSystem:
    def __init__(self):
        self.deterrent_modes = {
            "low": ["strobe_light"],
            "medium": ["strobe_light", "ultrasonic_sound"],
            "high": ["strobe_light", "ultrasonic_sound", "water_spray"]
        }
        self.night_mode = False
        
    def determine_deterrent_level(self, detection_data):
        """Determinar nivel de disuasión basado en patrones"""
        detection_count = detection_data.get('detection_count', 0)
        distance = detection_data.get('distance_cm', 0)
        time_of_day = datetime.now().hour
        
        # Modo nocturno (más agresivo)
        self.night_mode = 18 <= time_of_day <= 6
        
        if detection_count > 10 or distance < 30:
            return "high"
        elif detection_count > 5 or (distance < 100 and self.night_mode):
            return "medium"
        else:
            return "low"
    
    def activate_deterrents(self, level, sensor_id):
        """Activar disuasores según nivel"""
        deterrents = self.deterrent_modes[level]
        
        message = f"🔧 ACTIVANDO DISUASORES - Nivel {level.upper()}\n"
        message += f"📍 Sensor: {sensor_id}\n"
        message += f"🎯 Métodos: {', '.join(deterrents)}\n"
        
        # Publicar comando MQTT para activar disuasores
        mqtt_client.publish(
            f"pest/control/{sensor_id}",
            json.dumps({
                "level": level,
                "deterrents": deterrents,
                "duration": 30 if level == "high" else 15
            })
        )
        
        return message
```

